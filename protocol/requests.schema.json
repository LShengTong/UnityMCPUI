{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UiAssetSearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "type": "string",
          "enum": [
            "ui_prefab",
            "sprite",
            "tmp_font"
          ],
          "x-python-alias": "UiAssetTypeValue"
        },
        "search": {
          "type": "string",
          "default": "",
          "maxLength": 200
        },
        "folder": {
          "type": "string",
          "default": "Assets"
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "asset_type"
      ]
    },
    "UiAssetInspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_path": {
          "type": "string"
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "ui_prefab",
            "sprite",
            "tmp_font"
          ],
          "x-python-alias": "UiAssetTypeValue"
        },
        "local_id": {
          "type": "string",
          "default": "",
          "pattern": "^(?:-?[0-9]+)?$"
        },
        "text": {
          "type": "string",
          "default": "",
          "maxLength": 1024
        },
        "search_fallbacks": {
          "type": "boolean",
          "default": true
        },
        "max_nodes": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "asset_path",
        "asset_type"
      ]
    },
    "UiNodeAddition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add"
          ]
        },
        "parent_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,63}$"
        },
        "node": {
          "$ref": "ui.schema.json#/$defs/UiPrefabNode"
        },
        "sibling_index": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 2000
        }
      },
      "required": [
        "action",
        "parent_path",
        "node"
      ]
    },
    "UiNodeDeletion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "delete"
          ]
        },
        "index_path": {
          "type": "string",
          "pattern": "^0/(?:0|[1-9][0-9]*)(?:/(?:0|[1-9][0-9]*)){0,63}$"
        }
      },
      "required": [
        "action",
        "index_path"
      ]
    },
    "UiNodeMove": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "move"
          ]
        },
        "index_path": {
          "type": "string",
          "pattern": "^0/(?:0|[1-9][0-9]*)(?:/(?:0|[1-9][0-9]*)){0,63}$"
        },
        "parent_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "sibling_index": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 2000
        },
        "world_position_stays": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "action",
        "index_path",
        "parent_path"
      ]
    },
    "UiPropertyModification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "property": {
          "type": "string",
          "enum": [
            "name",
            "active",
            "text",
            "font_size",
            "text_color",
            "font_path",
            "sprite_path",
            "color",
            "anchored_position",
            "size_delta",
            "anchor",
            "anchor_min",
            "anchor_max",
            "pivot",
            "offset_min",
            "offset_max",
            "spacing",
            "padding",
            "interactable",
            "image_type",
            "preferred_width",
            "preferred_height",
            "min_width",
            "min_height",
            "flexible_width",
            "flexible_height",
            "horizontal_fit",
            "vertical_fit",
            "grid_cell_size",
            "grid_spacing",
            "scroll_horizontal",
            "scroll_vertical",
            "text_alignment",
            "word_wrap",
            "auto_size",
            "font_size_min",
            "font_size_max",
            "text_overflow",
            "line_spacing",
            "preserve_aspect",
            "fill_method",
            "fill_origin",
            "fill_amount",
            "fill_clockwise",
            "raycast_target",
            "child_alignment",
            "child_control_width",
            "child_control_height",
            "child_force_expand_width",
            "child_force_expand_height",
            "child_scale_width",
            "child_scale_height",
            "grid_constraint",
            "grid_constraint_count",
            "grid_start_corner",
            "grid_start_axis"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        },
        "action": {
          "type": "string",
          "enum": [
            "modify"
          ]
        }
      },
      "required": [
        "index_path",
        "property",
        "value",
        "action"
      ]
    },
    "UiComponentAddition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add_component"
          ]
        },
        "index_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "component": {
          "type": "string",
          "enum": [
            "Image",
            "Button",
            "CanvasGroup",
            "LayoutElement",
            "ContentSizeFitter",
            "HorizontalLayoutGroup",
            "VerticalLayoutGroup",
            "GridLayoutGroup",
            "RectMask2D",
            "ScrollRect"
          ]
        },
        "viewport_path": {
          "type": "string",
          "default": ""
        },
        "content_path": {
          "type": "string",
          "default": ""
        },
        "horizontal": {
          "type": "boolean",
          "default": false
        },
        "vertical": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "action",
        "index_path",
        "component"
      ]
    },
    "UiBatchOperation": {
      "oneOf": [
        {
          "$ref": "#/$defs/UiPropertyModification"
        },
        {
          "$ref": "#/$defs/UiNodeAddition"
        },
        {
          "$ref": "#/$defs/UiNodeDeletion"
        },
        {
          "$ref": "#/$defs/UiNodeMove"
        },
        {
          "$ref": "#/$defs/UiComponentAddition"
        },
        {
          "$ref": "#/$defs/UiNodeDuplication"
        },
        {
          "$ref": "#/$defs/UiPrefabInstantiation"
        },
        {
          "$ref": "#/$defs/UiScriptAddition"
        },
        {
          "$ref": "#/$defs/UiReferenceAssignment"
        }
      ],
      "x-discriminator": "action"
    },
    "FindUiAssetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiAssetSearch"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "deadline",
        "queries"
      ],
      "x-request": true
    },
    "InspectUiAssetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiAssetInspection"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "deadline",
        "assets"
      ],
      "x-request": true
    },
    "BatchEditUiPrefabRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "asset_path": {
          "type": "string"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiBatchOperation"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "deadline",
        "asset_path",
        "expected_version",
        "operations"
      ],
      "x-request": true
    },
    "PreviewUiPrefabRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "asset_path": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "default": 1280,
          "minimum": 64,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "default": 720,
          "minimum": 64,
          "maximum": 2048
        },
        "background": {
          "type": "string",
          "default": "#202020"
        }
      },
      "required": [
        "id",
        "deadline",
        "asset_path"
      ],
      "x-request": true
    },
    "ImportUiImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "asset_path": {
          "type": "string"
        },
        "image_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11184812
        },
        "border": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            0,
            0,
            0,
            0
          ]
        },
        "pixels_per_unit": {
          "type": "number",
          "default": 100,
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "filter_mode": {
          "type": "string",
          "enum": [
            "point",
            "bilinear"
          ],
          "default": "bilinear"
        }
      },
      "required": [
        "id",
        "deadline",
        "asset_path",
        "image_base64"
      ],
      "x-request": true
    },
    "ListUiBackupsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "asset_path": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "deadline",
        "asset_path"
      ],
      "x-request": true
    },
    "RestoreUiPrefabRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "backup_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "id",
        "deadline",
        "backup_id",
        "expected_version"
      ],
      "x-request": true
    },
    "UiPropertyChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "property": {
          "type": "string",
          "enum": [
            "name",
            "active",
            "text",
            "font_size",
            "text_color",
            "font_path",
            "sprite_path",
            "color",
            "anchored_position",
            "size_delta",
            "anchor",
            "anchor_min",
            "anchor_max",
            "pivot",
            "offset_min",
            "offset_max",
            "spacing",
            "padding",
            "interactable",
            "image_type",
            "preferred_width",
            "preferred_height",
            "min_width",
            "min_height",
            "flexible_width",
            "flexible_height",
            "horizontal_fit",
            "vertical_fit",
            "grid_cell_size",
            "grid_spacing",
            "scroll_horizontal",
            "scroll_vertical",
            "text_alignment",
            "word_wrap",
            "auto_size",
            "font_size_min",
            "font_size_max",
            "text_overflow",
            "line_spacing",
            "preserve_aspect",
            "fill_method",
            "fill_origin",
            "fill_amount",
            "fill_clockwise",
            "raycast_target",
            "child_alignment",
            "child_control_width",
            "child_control_height",
            "child_force_expand_width",
            "child_force_expand_height",
            "child_scale_width",
            "child_scale_height",
            "grid_constraint",
            "grid_constraint_count",
            "grid_start_corner",
            "grid_start_axis"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "index_path",
        "property",
        "value"
      ]
    },
    "UiNodeDuplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "duplicate"
          ]
        },
        "index_path": {
          "type": "string",
          "pattern": "^0/(?:0|[1-9][0-9]*)(?:/(?:0|[1-9][0-9]*)){0,63}$"
        },
        "parent_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "name": {
          "type": "string",
          "default": "",
          "maxLength": 80,
          "pattern": "^[^/\\\\\\x00-\\x1f]*$"
        },
        "sibling_index": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 2000
        }
      },
      "required": [
        "action",
        "index_path",
        "parent_path"
      ]
    },
    "UiPrefabInstantiation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "instantiate_prefab"
          ]
        },
        "prefab_path": {
          "type": "string",
          "pattern": "^Assets/.+\\.prefab$"
        },
        "parent_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "name": {
          "type": "string",
          "default": "",
          "maxLength": 80,
          "pattern": "^[^/\\\\\\x00-\\x1f]*$"
        },
        "sibling_index": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 2000
        }
      },
      "required": [
        "action",
        "prefab_path",
        "parent_path"
      ]
    },
    "UiScriptAddition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add_script"
          ]
        },
        "index_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "script_path": {
          "type": "string",
          "pattern": "^Assets/.+\\.cs$"
        }
      },
      "required": [
        "action",
        "index_path",
        "script_path"
      ]
    },
    "UiReferenceAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "set_reference"
          ]
        },
        "index_path": {
          "type": "string",
          "pattern": "^0(?:/(?:0|[1-9][0-9]*)){0,64}$"
        },
        "component_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "component_index": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 2000
        },
        "field_path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "target_path": {
          "type": "string",
          "default": ""
        },
        "target_component": {
          "type": "string",
          "default": "",
          "maxLength": 512
        },
        "target_component_index": {
          "type": "integer",
          "default": -1,
          "minimum": -1,
          "maximum": 2000
        },
        "clear": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "action",
        "index_path",
        "component_type",
        "field_path"
      ]
    },
    "RefreshAssetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "deadline"
      ],
      "x-request": true
    },
    "EnterPlayModeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "mode": {
          "type": "string",
          "enum": [
            "isolated",
            "current"
          ],
          "default": "isolated"
        },
        "reference_width": {
          "type": "number",
          "default": 1920,
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "reference_height": {
          "type": "number",
          "default": 1080,
          "exclusiveMinimum": 0,
          "maximum": 16384
        }
      },
      "required": [
        "id",
        "deadline"
      ],
      "x-request": true
    },
    "ExitPlayModeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "deadline"
      ],
      "x-request": true
    },
    "InspectRuntimeUiRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "test_instance_id": {
          "type": "string",
          "maxLength": 512,
          "default": ""
        },
        "scene_name": {
          "type": "string",
          "maxLength": 512,
          "default": ""
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "default": ""
        },
        "max_nodes": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "id",
        "deadline"
      ],
      "x-request": true
    },
    "MountTestPrefabRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "prefab_path": {
          "type": "string",
          "pattern": "^Assets/.+\\.prefab$"
        },
        "parent_path": {
          "type": "string",
          "maxLength": 512,
          "default": ""
        },
        "scene_name": {
          "type": "string",
          "maxLength": 512,
          "default": ""
        }
      },
      "required": [
        "id",
        "deadline",
        "prefab_path"
      ],
      "x-request": true
    },
    "ClearTestInstancesRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "deadline": {
          "type": "number"
        },
        "test_instance_id": {
          "type": "string",
          "maxLength": 512,
          "default": ""
        }
      },
      "required": [
        "id",
        "deadline"
      ],
      "x-request": true
    },
    "InvokeButtonStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "invoke_button"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "default": "0"
        }
      },
      "required": [
        "action"
      ]
    },
    "SetInputTextStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "set_input_text"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "default": "0"
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "notify": {
